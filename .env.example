# Database
DATABASE_URL="postgresql://user:password@localhost:5432/donormatch?schema=public"

# Redis (for BullMQ background jobs)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (embeddings + matching reasoning)
OPENAI_API_KEY="sk-..."

# Tavily (web search for donor discovery)
TAVILY_API_KEY="tvly-..."

# Perplexity (deep research with citations)
PERPLEXITY_API_KEY="pplx-..."

# Firecrawl (web crawling/scraping)
FIRECRAWL_API_KEY="fc-..."

# Google OAuth (optional — app works with just email/password)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paddle (billing & subscriptions)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"

# Paddle Price IDs (create these in your Paddle dashboard)
PADDLE_STARTER_PRICE_ID=""
PADDLE_PRO_PRICE_ID=""
PADDLE_ENRICHMENT_PRICE_ID=""
