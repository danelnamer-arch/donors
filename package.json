{
  "name": "funderra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx --env-file=.env prisma/seed.ts",
    "marathon": "npx tsx --env-file=.env scripts/marathon-discovery.ts",
    "marathon:resume": "npx tsx --env-file=.env scripts/marathon-discovery.ts --resume",
    "expand:israel": "npx tsx --env-file=.env scripts/israeli-expansion.ts",
    "expand:israel:resume": "npx tsx --env-file=.env scripts/israeli-expansion.ts --resume",
    "expand:israel:dry-run": "npx tsx --env-file=.env scripts/israeli-expansion.ts --dry-run",
    "seed:ngos": "npx tsx --env-file=.env scripts/seed-israeli-ngos.ts",
    "seed:ngos:matches": "npx tsx --env-file=.env scripts/seed-israeli-ngos.ts --matches-only",
    "normalize": "npx tsx --env-file=.env scripts/normalize-existing-data.ts",
    "normalize:dry-run": "npx tsx --env-file=.env scripts/normalize-existing-data.ts --dry-run",
    "normalize:embeddings": "npx tsx --env-file=.env scripts/normalize-existing-data.ts --embeddings-only",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@paddle/paddle-node-sdk": "^3.6.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@tavily/core": "^0.7.1",
    "@types/uuid": "^10.0.0",
    "bullmq": "^5.67.3",
    "framer-motion": "^12.34.0",
    "ioredis": "^5.9.2",
    "next": "^15.3.3",
    "next-auth": "^4.24.13",
    "openai": "^6.18.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
